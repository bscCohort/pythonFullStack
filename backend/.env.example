# Copy this file to .env and paste your own connection string in.
#   cp .env.example .env
#
# Get a free Postgres at https://neon.tech (or Vercel -> Storage -> Postgres).
# Use the POOLED string: its hostname contains "-pooler". A pooled connection
# copes with many short requests, which is exactly what a web app makes.
#
# Your provider may hand you 15 variables. You only need this one.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Optional. Defaults to 8000. Hosting providers set this for you.
# PORT=8000

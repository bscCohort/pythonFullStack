# Copy this file to .env
#   cp .env.example .env
#
# Where the API lives. "/api" means "the same address that served this page",
# which is what you want locally: Vite forwards /api to the Python server on
# port 8000 (see vite.config.js).
#
# IMPORTANT: every VITE_ variable is bundled into the JavaScript the browser
# downloads, so anyone can read it. Never put a password or a database URL here.
VITE_API_URL=/api
